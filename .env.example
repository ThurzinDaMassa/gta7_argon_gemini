# ================= BACKEND (server) =================
PORT=3000
HOST=0.0.0.0
SERVER_REGION=sa-east
LOG_LEVEL=info
SESSION_DAYS=14

# Origens permitidas no CORS (separadas por vírgula ou * em dev)
CORS_ORIGIN=http://localhost:5173,https://gta7-online.pages.dev

# Banco de Dados PostgreSQL (Neon Free em produção).
# Se omitido em desenvolvimento local, o servidor utiliza automaticamente PGlite persistente em ./server/.data/pglite
DATABASE_URL=
PGLITE_DIR=./.data/pglite

# ================= FRONTEND (client) =================
# URL pública do backend no Render (ex: https://gta7-online-server.onrender.com)
# Em desenvolvimento local com proxy do Vite, deixe vazio.
VITE_API_URL=
VITE_WS_URL=
